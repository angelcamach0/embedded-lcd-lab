# Copy this file to .env and edit values for your setup.
# Example:
#   cp .env.example .env

# Tooling / board
ARDUINO_CLI=arduino-cli
BOARD_FQBN=arduino:avr:uno
PORT=/dev/ttyACM0

# Playlist behavior
AUTO_DISCOVER_SKETCHES=true
PLAYLIST_CYCLES=0
WAIT_FOR_DONE=false
DONE_TOKEN=PLAYLIST_DONE
POST_SKIP_COOLDOWN_SECONDS=1.2
PORT_WAIT_TIMEOUT_SECONDS=6
UPLOAD_SETTLE_SECONDS=0.9
PRECOMPILE_ONCE=true
ENABLE_LEGACY_TTT_DURATION=false
ENABLE_TIMER_START_COMMAND=true
## Optional global runtime override for all sketches (HHMMSS).
# DURATION_OVERRIDE_HHMMSS=003000

# Weather feed behavior
ENABLE_SERIAL_FEED=true
SERIAL_FEED_SECONDS=60
WEATHER_LOCATION=El Paso
# Optional IP override (IPv4 or IPv6) for geolocation.
# If empty, script first tries auto public-IP geolocation, then falls back to WEATHER_LOCATION.
# WEATHER_IP=8.8.8.8
# Optional: set coordinates to bypass geocoding lookup.
# WEATHER_LAT=31.7619
# WEATHER_LON=-106.4850

# Optional location of env file itself when launching script:
# ENV_FILE=/path/to/custom.env
